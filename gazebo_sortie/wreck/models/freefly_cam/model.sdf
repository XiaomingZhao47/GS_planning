<?xml version="1.0"?>
<sdf version="1.5">
  <!-- Kinematic 6-DoF RGB-D camera. Gravity off, no collision; pose is set
       externally via /set_entity_state. gazebo_ros_p3d publishes /odom from
       the link's true world pose so sortie_recorder.py works unchanged. -->
  <model name="freefly_cam">
    <static>false</static>
    <link name="link">
      <gravity>0</gravity>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="camera" type="depth">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>30</update_rate>
        <camera name="picam">
          <horizontal_fov>1.085595</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>100</far></clip>
        </camera>
        <plugin name="camera_driver" filename="libgazebo_ros_camera.so">
          <ros><namespace>/</namespace></ros>
        </plugin>
      </sensor>
      <plugin name="p3d" filename="libgazebo_ros_p3d.so">
        <ros>
          <namespace>/</namespace>
          <remapping>odom:=/odom</remapping>
        </ros>
        <body_name>link</body_name>
        <frame_name>world</frame_name>
        <update_rate>30</update_rate>
        <gaussian_noise>0.0</gaussian_noise>
      </plugin>
    </link>
  </model>
</sdf>
